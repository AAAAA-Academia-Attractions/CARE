# Data
MIMIC_DB_PATH=./data/mimiciv.duckdb
MIMIC_RAW_CSV_DIR=/path/to/licensed/mimic-iv-csv-root
MIMIC_CODE_DIR=/path/to/external/mimic-code-checkout
# These files are generated locally from the dataset construction commands in README.md.
SAMPLE_LOCK_FILE=data/samples/mimic_dos_local_y0_12_n1000_seed74021.csv
FEATURE_STORE_CSV=data/feature_store/mimic_dos_local_y0_12_n1000_seed74021__feature_package.csv
FEATURE_SOURCE=locked_csv

# Locally hosted OpenAI-compatible LLM endpoint
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=your_local_model

# Remote advisory endpoint
REMOTE_API_KEY=replace_me
REMOTE_BASE_URL=your_remote_base_url_here
REMOTE_MODEL=your_remote_model
REMOTE_PROVIDER=standard

# Runtime
CARE_TRACE_PROGRESS=true
CARE_MAX_COMPLETION_TOKENS=20000
CARE_PLANNER_MAX_COMPLETION_TOKENS=15000
CARE_ADVISOR_MAX_COMPLETION_TOKENS=12000
CARE_DECISION_MAX_COMPLETION_TOKENS=20000
